# FinSight — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ─────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=           # Generate: openssl rand -base64 32
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# DATABASE (Supabase PostgreSQL)
# Get from: supabase.com → Project Settings → Database
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ─────────────────────────────────────────────────────────────
# GOOGLE OAUTH
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# AI — GOOGLE GEMINI API
# Get from: aistudio.google.com → Get API Key
# Model used: gemini-2.5-flash
# ─────────────────────────────────────────────────────────────
GOOGLE_AI_API_KEY=AIza...

# ─────────────────────────────────────────────────────────────
# PRODUCTION ONLY (Vercel)
# ─────────────────────────────────────────────────────────────
# NEXTAUTH_URL=https://finsight.vercel.app
# NEXT_PUBLIC_APP_URL=https://finsight.vercel.app
